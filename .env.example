# Google Custom Search API — used to find LinkedIn profiles via Google
# Get your API key: https://console.cloud.google.com/apis/credentials
# Get your Search Engine ID: https://programmablesearchengine.google.com/
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_custom_search_engine_id_here

# Google Sheets — service account credentials for writing leads
# Create a service account: https://console.cloud.google.com/iam-admin/serviceaccounts
# Download the JSON key and place it at the path below
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# The Google Sheet ID where leads will be written
# (the long string in the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit)
GOOGLE_SHEET_ID=your_google_sheet_id_here
